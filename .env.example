# Copy to .env for local dev (never commit .env).
# Upstream provider Bulwark forwards to. Default target is Anthropic's
# OpenAI-compatible layer (Claude models); swap UPSTREAM_BASE_URL to point
# Bulwark at any other OpenAI-compatible provider.
ANTHROPIC_API_KEY=sk-ant-your-key-here
UPSTREAM_BASE_URL=https://api.anthropic.com

# PORT is injected by Railway in production; locally the app defaults to 8080.

# Layer 2 classifier sidecar (docker-compose). Defaults bake in the DeBERTa model;
# override to serve a different prompt-injection model.
# CLASSIFIER_MODEL_ID=protectai/deberta-v3-base-prompt-injection
# CLASSIFIER_INJECTION_LABELS=INJECTION   # label(s) meaning "injection" for that model
# HF_TOKEN=hf_...                         # build-time only, for gated models; never stored in the image