# Copy to .env for local dev (never commit .env).
# Upstream provider Bulwark forwards to. Default target is Anthropic's
# OpenAI-compatible layer (Claude models); swap UPSTREAM_BASE_URL to point
# Bulwark at any other OpenAI-compatible provider.
ANTHROPIC_API_KEY=sk-ant-your-key-here
UPSTREAM_BASE_URL=https://api.anthropic.com

# PORT is injected by Railway in production; locally the app defaults to 8080.